{
  "name": "konomi-p2p",
  "version": "1.0.0",
  "description": "Peer-to-peer client for GitHub Pages - no server needed",
  "type": "module",
  "main": "dist/konomi-p2p.min.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "browser": "./dist/konomi-p2p.min.js"
    },
    "./core": "./src/core/index.js",
    "./core/*": "./src/core/*.js",
    "./network": "./src/network/index.js",
    "./network/*": "./src/network/*.js",
    "./sync": "./src/sync/index.js",
    "./sync/*": "./src/sync/*.js",
    "./protocols": "./src/protocols/index.js",
    "./protocols/*": "./src/protocols/*.js",
    "./enterprise": "./src/enterprise/index.js",
    "./enterprise/*": "./src/enterprise/*.js",
    "./bridge": "./src/bridge/index.js",
    "./bridge/*": "./src/bridge/*.js",
    "./sw": "./src/sw/index.js",
    "./sw/*": "./src/sw/*.js",
    "./os": "./src/os/index.js",
    "./os/*": "./src/os/*.js",
    "./llm": "./src/llm/index.js",
    "./llm/*": "./src/llm/*.js",
    "./widgets": "./src/widgets/index.js",
    "./widgets/*": "./src/widgets/*.js",
    "./udts": "./src/lib/udts/index.js",
    "./udts/*": "./src/lib/udts/*",
    "./config": "./src/config.js",
    "./telephony": {
      "import": "./src/network/konotel.js"
    },
    "./telephony/cell": "./src/network/cell.js",
    "./telephony/freecomm": "./src/network/freecomm.js",
    "./telephony/konotel": "./src/network/konotel.js"
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rm -rf dist/*",
    "serve": "serve . -l 3000",
    "test": "npm run test:pages && npm run test:js",
    "test:pages": "bash test/e2e/check-pages.sh",
    "test:js": "node test/e2e/validate-js.js"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "playwright": "^1.40.0",
    "rollup": "^4.0.0",
    "serve": "^14.0.0"
  },
  "keywords": [
    "p2p",
    "peer-to-peer",
    "libp2p",
    "crdt",
    "yjs",
    "decentralized",
    "github-pages",
    "offline-first",
    "real-time",
    "collaboration",
    "voip",
    "telephony",
    "mesh-network",
    "sip",
    "webrtc",
    "isa-95",
    "industrial",
    "sparkplug",
    "twilio-alternative",
    "free-cell"
  ],
  "author": "Konomi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/konomi/kp2p"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browser": {
    "crypto": false
  }
}
