{
  "name": "konomi-p2p",
  "version": "1.0.0",
  "description": "Peer-to-peer client for GitHub Pages - no server needed",
  "type": "module",
  "main": "dist/konomi-p2p.min.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "browser": "./dist/konomi-p2p.min.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "clean": "rm -rf dist/*",
    "serve": "serve . -l 3000",
    "test": "npm run test:pages && npm run test:js",
    "test:pages": "bash test/e2e/check-pages.sh",
    "test:js": "node test/e2e/validate-js.js"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "playwright": "^1.40.0",
    "rollup": "^4.0.0",
    "serve": "^14.0.0"
  },
  "keywords": [
    "p2p",
    "peer-to-peer",
    "libp2p",
    "crdt",
    "yjs",
    "decentralized",
    "github-pages",
    "offline-first",
    "real-time",
    "collaboration"
  ],
  "author": "Konomi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/konomi/kp2p"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "browser": {
    "crypto": false
  }
}
