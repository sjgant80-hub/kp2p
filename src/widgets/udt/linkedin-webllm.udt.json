  "presentation": {
    "icon": "💼",
    "color": "#0a66c2"
  },
  "description": {
    "short": "P2P LinkedIn automation with WebLLM AI and remote browser",
    "medium": "AI-powered LinkedIn bot with P2P mesh networking and remote Chrome browser streaming. Stream a full Chrome instance via WebSocket, control it with mouse/keyboard, run AI automation, and sync with multiple bots via WebRTC.",
    "features": [
      "WebLLM-powered message generation",
      "P2P mesh for multi-bot coordination",
      "Connection request automation",
      "Post scheduling and generation",
      "Follow-up sequence builder",
      "Profile analysis",
      "Template library",
      "Queue management with peer sync",
      "Remote Chrome browser streaming",
      "Canvas-based browser viewport",
      "Mouse and keyboard forwarding",
      "Action recording and playback",
      "AI-powered browser automation",
      "Script injection support",
      "CDP/Puppeteer/Browserless integration"
    ]
  },
  "commercial": {
    "price": 100,
    "kills": [
      "LinkedIn Sales Nav $100/mo",
      "Expandi $99/mo",
      "Dux-Soup $55/mo",
      "PhantomBuster $69/mo",
      "Octopus CRM $10/mo",
      "Zopto $215/mo"
    ],
    "license": "MIT"
  },
  "technical": {
    "runtime": "browser",
    "standalone": true,
    "offline": true,
    "p2pEnabled": true,
    "dependencies": [
      "@mlc-ai/web-llm"
    ],
    "storage": {
      "localStorage": true,
      "indexedDB": false
    },
    "apis": [
      "WebGPU",
      "WebRTC",
      "WebSocket",
      "Canvas2D",
      "Fullscreen"
    ]
  },
  "interface": {
    "globalName": "LinkedInBot",
    "methods": [
      "send(text)",
      "addToQueue(item)",
      "generateMessage(type, context)",
      "syncWithPeers()",
      "openLinkedIn()",
      "browser.connect()",
      "browser.navigate(url)",
      "browser.screenshot()",
      "browser.clickByAI(description)",
      "browser.typeText(text)",
      "browser.runSequence(actions)",
      "browser.toggleRecording()"
    ],
    "events": [
      "ready",
      "peer-connected",
      "peer-left",
      "queue-updated",
      "message-generated",
      "browser-connected",
      "browser-frame",
      "browser-action"
    ]
  },
  "lifecycle": {
