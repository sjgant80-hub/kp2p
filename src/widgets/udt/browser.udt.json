  "presentation": {
    "icon": "🌐",
    "color": "#4285f4"
  },
  "description": {
    "short": "Remote Chrome browser streaming widget",
    "medium": "Sandboxed remote browser widget that streams a Chrome instance via WebSocket. Supports Puppeteer, Browserless, CDP, and noVNC. Can be embedded in other widgets via iframe or referenced via postMessage API.",
    "features": [
      "WebSocket-based browser streaming",
      "Canvas viewport with FPS counter",
      "Full mouse event forwarding",
      "Full keyboard event forwarding",
      "Scroll wheel support",
      "Screenshot capture and download",
      "Script injection/eval",
      "Action recording and playback",
      "Context menu with shortcuts",
      "URL bar with navigation",
      "Back/forward/refresh controls",
      "Fullscreen mode",
      "PostMessage API for embedding",
      "Multiple connection types (Stream, CDP, Browserless, VNC)",
      "Settings persistence",
      "Keyboard shortcuts (F5, Alt+arrows, Ctrl+L)"
    ]
  },
  "commercial": {
    "price": 30,
    "kills": [
      "BrowserStack $29/mo",
      "Sauce Labs $39/mo",
      "LambdaTest $15/mo",
      "CrossBrowserTesting $40/mo"
    ],
    "license": "MIT"
  },
  "technical": {
    "runtime": "browser",
    "standalone": true,
    "offline": false,
    "p2pEnabled": false,
    "dependencies": [],
    "storage": {
      "localStorage": true,
      "indexedDB": false
    },
    "apis": [
      "WebSocket",
      "Canvas2D",
      "Fullscreen",
      "Clipboard"
    ]
  },
  "interface": {
    "globalName": "SandboxBrowser",
    "methods": [
      "connect(url, type)",
      "disconnect()",
      "navigate(url)",
      "back()",
      "forward()",
      "refresh()",
      "screenshot()",
      "typeText(text, delay)",
      "toggleRecording()",
      "playRecording()",
      "getRecording()",
      "getUrl()",
      "isConnected()",
      "toggleFullscreen()"
    ],
    "events": [
      "connect",
      "disconnect",
      "frame",
      "url-change",
      "error"
    ],
    "postMessage": {
      "description": "Can be controlled via postMessage when embedded in iframe",
      "commands": [
        "connect",
        "disconnect",
        "navigate",
        "back",
        "forward",
        "refresh",
        "screenshot",
        "eval",
        "click",
        "type"
      ]
    }
  },
  "embedding": {
    "iframe": true,
    "reference": true,
    "example": "const frame = document.createElement('iframe');\nframe.src = 'browser.html';\nframe.onload = () => {\n  frame.contentWindow.SandboxBrowser.connect('ws://localhost:3000');\n};"
  },
